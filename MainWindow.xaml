<Window x:Class="UnityBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UnityBrowser"
        Title="Unity Browser" Height="820" Width="1320" Icon="app.ico"
        AllowDrop="True" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Open _File..." InputGestureText="Ctrl+O" Click="OpenFile_Click" />
                <MenuItem Header="Open F_older..." InputGestureText="Ctrl+Shift+O" Click="OpenFolder_Click" />
                <Separator />
                <MenuItem Header="_Close All" Click="CloseAll_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Export">
                <MenuItem x:Name="ExportPngMenu" Header="Export Selected as _PNG..." InputGestureText="Ctrl+E"
                          Click="ExportPng_Click" />
                <MenuItem x:Name="ExportDdsMenu" Header="Export Selected as _DDS..." InputGestureText="Ctrl+Shift+E"
                          Click="ExportDds_Click" />
                <MenuItem x:Name="ExportWavMenu" Header="Export Selected as _WAV..." InputGestureText="Ctrl+Shift+W"
                          Click="ExportWav_Click" />
                <MenuItem x:Name="ExportObjMenu" Header="Export Selected as _OBJ..." Click="ExportObj_Click" />
                <MenuItem x:Name="ExportDaeMenu" Header="Export Selected as D_AE (COLLADA)..." Click="ExportDae_Click" />
                <Separator />
                <MenuItem x:Name="ExportAllMenu" Header="Export _All Known Formats..." InputGestureText="Ctrl+Shift+A"
                          Click="ExportAll_Click" />
                <Separator />
                <MenuItem Header="_Preferences..." Click="Preferences_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Collapse All" Click="CollapseAll_Click" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Open a Unity file or folder (File menu, or drag and drop)." />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="Tree" Grid.Column="0" BorderThickness="0"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectedItemChanged="Tree_SelectedItemChanged"
                      PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown">
                <TreeView.Resources>
                    <!-- The export selection is drawn by the item template; hide the built-in single-selection highlight. -->
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black" />
                </TreeView.Resources>
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Export Selected as _PNG..." InputGestureText="Ctrl+E" Click="ExportPng_Click" />
                        <MenuItem Header="Export Selected as _DDS..." InputGestureText="Ctrl+Shift+E" Click="ExportDds_Click" />
                        <MenuItem Header="Export Selected as _WAV..." InputGestureText="Ctrl+Shift+W" Click="ExportWav_Click" />
                        <MenuItem Header="Export Selected as _OBJ..." Click="ExportObj_Click" />
                        <MenuItem Header="Export Selected as D_AE (COLLADA)..." Click="ExportDae_Click" />
                        <Separator />
                        <MenuItem Header="Export _All Known Formats..." InputGestureText="Ctrl+Shift+A" Click="ExportAll_Click" />
                    </ContextMenu>
                </TreeView.ContextMenu>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type local:TreeNode}" ItemsSource="{Binding Children}">
                        <Border x:Name="RowBorder" Padding="3,1" CornerRadius="2" BorderThickness="1" BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{Binding IconBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Header}" Foreground="{Binding HeaderBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Detail}" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>
                        <HierarchicalDataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#FF7EB4EA" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#FFCCE4FA" />
                            </DataTrigger>
                        </HierarchicalDataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#FFE0E0E0" />

            <Grid Grid.Column="2" Background="#FFFAFAFA">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="PreviewRow" Height="0" />
                    <RowDefinition x:Name="PreviewSplitterRow" Height="Auto" />
                    <RowDefinition x:Name="PropertiesRow" Height="*" MinHeight="80" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12,10" BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel x:Name="MeshToolbar" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                            <ToggleButton x:Name="MeshSubmeshColours" Content="Sub-mesh colours" Padding="10,2" Margin="0,0,4,0"
                                          Click="MeshSubmeshColours_Click" ToolTip="Tint each sub-mesh in its own colour" />
                            <Button Content="Reset view" Padding="10,2" Click="MeshResetView_Click" />
                        </StackPanel>
                        <StackPanel x:Name="PreviewToolbar" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock x:Name="ZoomText" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ToggleButton x:Name="FitToggle" Content="Fit" IsChecked="True" Padding="10,2" Margin="0,0,4,0"
                                          Click="FitToggle_Click" ToolTip="Fit to panel (off: actual size, mouse wheel zooms)" />
                            <ToggleButton x:Name="AlphaToggle" Content="Alpha" IsChecked="True" Padding="10,2"
                                          Click="AlphaToggle_Click" ToolTip="Show transparency" />
                        </StackPanel>
                        <TextBlock x:Name="ViewerTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Text="Nothing selected" />
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1" x:Name="PreviewArea" Visibility="Collapsed">
                    <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="PreviewScroll_PreviewMouseWheel"
                                  SizeChanged="PreviewScroll_SizeChanged">
                        <Border x:Name="PreviewFrame" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                            <Border.Background>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#FFFFFFFF" Geometry="M0,0 H2 V2 H0Z" />
                                            <GeometryDrawing Brush="#FFD6D6D6" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z" />
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Border.Background>
                            <Image x:Name="PreviewImage" Stretch="Uniform" />
                        </Border>
                    </ScrollViewer>
                    <TextBlock x:Name="PreviewMessage" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="24" Foreground="Gray" Visibility="Collapsed" />

                    <!-- 3D mesh viewer (Mesh) -->
                    <Border x:Name="MeshPanel" Visibility="Collapsed" ClipToBounds="True" Cursor="SizeAll"
                            MouseDown="MeshPanel_MouseDown" MouseMove="MeshPanel_MouseMove" MouseUp="MeshPanel_MouseUp"
                            MouseWheel="MeshPanel_MouseWheel">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF3A3F47" Offset="0" />
                                <GradientStop Color="#FF1B1D21" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Viewport3D x:Name="MeshViewport" IsHitTestVisible="False">
                                <Viewport3D.Camera>
                                    <PerspectiveCamera x:Name="MeshCamera" FieldOfView="40" NearPlaneDistance="0.001"
                                                       FarPlaneDistance="100000" UpDirection="0,1,0" />
                                </Viewport3D.Camera>
                                <ModelVisual3D>
                                    <ModelVisual3D.Content>
                                        <Model3DGroup x:Name="MeshScene" />
                                    </ModelVisual3D.Content>
                                </ModelVisual3D>
                            </Viewport3D>
                            <TextBlock Text="Left-drag: rotate   Right/middle-drag: pan   Wheel: zoom   Double-click: reset"
                                       Foreground="#99FFFFFF" FontSize="11" Margin="10,0,0,8"
                                       HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False" />
                        </Grid>
                    </Border>

                    <!-- Audio player (AudioClip) -->
                    <Grid x:Name="AudioPanel" Visibility="Collapsed" Margin="24" VerticalAlignment="Center" MaxWidth="1100">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="WaveformHost" Grid.Row="0" Height="150" Background="#FF1F2226" CornerRadius="4"
                                Cursor="Hand" ClipToBounds="True" MouseLeftButtonDown="Waveform_MouseLeftButtonDown"
                                ToolTip="Click to jump to a position">
                            <Grid>
                                <Image x:Name="WaveformImage" Stretch="Fill" />
                                <Rectangle x:Name="PlayedOverlay" HorizontalAlignment="Left" Width="0" Fill="#28FFFFFF" />
                                <Rectangle x:Name="Playhead" HorizontalAlignment="Left" Width="2" Fill="#FFFFC107" />
                            </Grid>
                        </Border>
                        <Slider x:Name="PositionSlider" Grid.Row="1" Margin="0,10,0,0" Minimum="0" Maximum="1"
                                IsMoveToPointEnabled="True" ValueChanged="PositionSlider_ValueChanged" />
                        <DockPanel Grid.Row="2" Margin="0,6,0,0">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button x:Name="PlayPauseButton" Width="44" Height="34" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                        Content="&#xE768;" Click="PlayPause_Click" ToolTip="Play / Pause (Space)" />
                                <Button Width="44" Height="34" Margin="6,0,0,0" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                        Content="&#xE71A;" Click="StopAudio_Click" ToolTip="Stop" />
                                <TextBlock x:Name="AudioTimeText" VerticalAlignment="Center" Margin="14,0,0,0"
                                           FontFamily="Consolas" FontSize="14" Text="0:00 / 0:00" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE767;" FontSize="16" Foreground="Gray"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Slider x:Name="VolumeSlider" Width="130" Minimum="0" Maximum="1" Value="0.8"
                                        VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" ToolTip="Volume" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Grid>

                <GridSplitter Grid.Row="2" x:Name="PreviewSplitter" Height="5" HorizontalAlignment="Stretch"
                              Background="#FFE0E0E0" Visibility="Collapsed" />

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="12,8">
                    <ItemsControl x:Name="PropertyList" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:PropertyRow}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" Foreground="Gray" Margin="0,0,16,0" />
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True"
                                             BorderThickness="0" Background="Transparent" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
